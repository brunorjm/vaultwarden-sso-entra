# ==============================================================================
# Vaultwarden + Key Connector — variáveis de ambiente
#
# NUNCA versione o .env preenchido. Este arquivo é só o molde.
# Em produção os valores são injetados pelo Dockhand.
#
# [OBRIGATÓRIA] = o compose usa ${VAR:?...}. Se faltar, o deploy FALHA
#                 apontando o nome da variável. Nada sobe pela metade.
# [opcional]    = tem default no compose. Pode não ser entregue.
#
# !!! ESCAPE DE CIFRÃO !!!
# Em arquivo .env local o Docker Compose interpreta `$`. Todo `$` do valor
# precisa virar `$$` — vale para o ADMIN_TOKEN (hash Argon2id) e para
# senhas que contenham `$`. Quando o Dockhand injeta como variável de
# ambiente real, NÃO escape.
# ==============================================================================

# ---------- Imagens (tags fixas, nunca latest/testing sem digest) ----------
# [OBRIGATÓRIA] Fork com o PR #7419. Resolva o digest antes de publicar:
#   docker pull ghcr.io/acul021/vaultwarden:testing
#   docker inspect --format={{index .RepoDigests 0}} ghcr.io/acul021/vaultwarden:testing
# Somente amd64.
VW_IMAGE=ghcr.io/acul021/vaultwarden@sha256:COLE_O_DIGEST_AQUI
# [OBRIGATÓRIA] Construída de um commit fixo e publicada no registry da
# Example Corp (ver README). A VPS precisa conseguir puxar esta imagem.
KC_IMAGE=ghcr.io/<seu-usuario>/key-connector:COMMIT_SHA

# ---------- Servidor ----------
# [OBRIGATÓRIA] Precisa bater exatamente com o subdomínio publicado no
# NPMplus, com https:// e sem barra no final. O redirect URI do Entra
# deriva daqui.
VW_DOMAIN=https://vault.example.com

# ---------- Banco de dados ----------
# [OBRIGATÓRIA] Role e database dedicados. Host é o IP da tailnet.
# O database precisa EXISTIR antes do primeiro deploy: o Vaultwarden roda
# as migrations no boot e entra em crash-loop se não conseguir conectar.
VW_DATABASE_URL=postgresql://vaultwarden:TROQUE_ESTA_SENHA@100.64.0.10:5432/vaultwarden
# [opcional] default 10
VW_DATABASE_MAX_CONNS=10

# ---------- Cadastro ----------
# [opcional] default false — ninguém entra sem convite.
# Ligue TEMPORARIAMENTE para criar a primeira conta quando o SMTP ainda
# não estiver pronto: o login via SSO cria a conta sozinho, sem e-mail.
# Mesmo ligado, só passa quem está na whitelist de domínio E atribuído à
# aplicação no Entra. Volte para false assim que criar sua conta.
VW_SIGNUPS_ALLOWED=false
# [OBRIGATÓRIA]
VW_SIGNUPS_DOMAINS_WHITELIST=example.com
# [opcional] default "Example Corp" — só aparece no e-mail de convite
VW_INVITATION_ORG_NAME=Example Corp
# [OBRIGATÓRIA] Quem pode criar organizações. Vazio deixaria QUALQUER
# usuário criar, por isso o compose exige valor explícito.
VW_ORG_CREATION_USERS=admin@example.com

# ---------- SSO — Microsoft Entra ID ----------
# [OBRIGATÓRIA] Directory (tenant) ID. O sufixo /v2.0 é obrigatório.
VW_SSO_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
# [OBRIGATÓRIA] Application (client) ID do App Registration.
VW_SSO_CLIENT_ID=00000000-0000-0000-0000-000000000000
# [OBRIGATÓRIA] Client secret VALUE (não o Secret ID). Só aparece uma vez.
VW_SSO_CLIENT_SECRET=TROQUE_ESTE_SEGREDO
# [OBRIGATÓRIA] Com Key Connector ativo, mantenha true. Durante a janela de
# migração de contas antigas, use false temporariamente.
VW_SSO_ONLY=true
# [opcional] Aplica-se apenas a Owner/Admin, que não podem se inscrever no
# Key Connector e continuam com senha mestra. JSON em uma linha.
VW_SSO_MASTER_PASSWORD_POLICY={"minComplexity":3,"minLength":14,"requireLower":true,"requireUpper":true,"requireNumbers":true,"requireSpecial":true}

# ---------- Key Connector ----------
# [OBRIGATÓRIA]
VW_KEY_CONNECTOR_ENABLED=true
# [OBRIGATÓRIA] URL PÚBLICA — é ela que os clientes (web vault, extensão,
# app, desktop, CLI) chamam. Eles concatenam direto: <esta URL> + "/user-keys".
# NUNCA termine com barra: geraria "//user-keys".
VW_KEY_CONNECTOR_URL=https://vault.example.com/keyconnector
# [OBRIGATÓRIA] Idêntico ao nome da organização criada no Vaultwarden.
VW_KEY_CONNECTOR_ORG_NAME=Example Corp

# [OBRIGATÓRIA] Endpoint de identidade do Vaultwarden, de onde o KC busca o JWKS.
KC_IDENTITY_AUTHORITY=https://vault.example.com/identity
# [OBRIGATÓRIA] Gere com:  openssl rand -base64 32
# PERDER ESTA CHAVE = TODOS OS COFRES INDECIFRÁVEIS, SEM RECUPERAÇÃO.
# Guarde uma cópia offline, em local separado do backup do banco do KC.
KC_ENCRYPTION_KEY=

# ---------- Painel /admin ----------
# [OBRIGATÓRIA] Vazio desabilitaria o painel silenciosamente. Gere com:
#   docker run --rm -it ghcr.io/acul021/vaultwarden:testing /vaultwarden hash
# Cole o hash Argon2id. Em arquivo .env, troque cada `$` por `$$`.
VW_ADMIN_TOKEN=

# ---------- SMTP ----------
# TODAS [opcionais]. VW_SMTP_HOST vazio desliga o envio de e-mail e o
# servidor sobe normalmente — útil para implantar antes do relay estar
# pronto. Falha aqui não é silenciosa: aparece no primeiro convite.
#
# Duas opções comuns:
#
# a) Azure Communication Services — credencial de aplicativo, sem senha
#    de pessoa. Usuário é <recurso-ACS>.<AppId>.<TenantId> e a senha é o
#    client secret de um App Registration dedicado (NÃO o do SSO).
#      VW_SMTP_HOST=smtp.azurecomm.net
#
# b) Microsoft 365 — exige mailbox LICENCIADA (caixa compartilhada não
#    faz SMTP AUTH) com Authenticated SMTP habilitado no Exchange.
#      VW_SMTP_HOST=smtp.office365.com
#
# O Vaultwarden NÃO implementa OAuth/XOAUTH2 para SMTP: não dá para
# entregar app id + secret direto ao Microsoft 365. Daí a opção (a).
VW_SMTP_HOST=smtp.azurecomm.net
# default 587
VW_SMTP_PORT=587
# default starttls
VW_SMTP_SECURITY=starttls
# Precisa ser um remetente verificado no provedor.
VW_SMTP_FROM=no-reply@example.com
# default "Cofre Corporativo"
VW_SMTP_FROM_NAME=Cofre Corporativo
VW_SMTP_USERNAME=
VW_SMTP_PASSWORD=

# ---------- Push mobile ----------
# [opcional] default false. Registre em https://bitwarden.com/host/
# para obter o par ID/KEY.
VW_PUSH_ENABLED=false
VW_PUSH_INSTALLATION_ID=
VW_PUSH_INSTALLATION_KEY=
